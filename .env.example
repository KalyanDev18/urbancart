# ===================================================================
# UrbanCart Environment Variables Configuration (.env)
# ===================================================================

# 1. Django Security Settings
SECRET_KEY=django-insecure-urbancart-secret-key-super-safe-dev
DEBUG=True

# 2. Email OTP Service Configuration (Gmail SMTP)
# Follow these 3 simple steps to get real OTPs in your Gmail inbox:
# Step 1: Open Google Account -> Security -> Turn ON "2-Step Verification"
# Step 2: Go to App Passwords: https://myaccount.google.com/apppasswords
# Step 3: Create an App Password for "UrbanCart" (gives a 16-letter code)
# Step 4: Fill in your Gmail and that 16-letter code below:

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_letter_google_app_password
DEFAULT_FROM_EMAIL=UrbanCart <your_email@gmail.com>
